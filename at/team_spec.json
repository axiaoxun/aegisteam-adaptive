    {
      "name": "regulator_notice_flow",
      "trigger_scenario": "regulator_notice",
      "agents": ["a0-leader", "a1", "a3", "a4", "a5", "a6"],
      "step_count": 26
    },
    {
      "name": "new_regulation_flow",
      "trigger_scenario": "new_regulation",
      "agents": ["a0-leader", "a1", "a3", "a4", "a5", "a6", "a7"],
      "step_count": 14,
      "dual_path": ["management", "technical"]
