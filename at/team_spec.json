  "creation_strategy": {
    "mode": "serial",
    "order": [
      "a1-asset-manager",
      "a2-threat-detector",
      "a3-vuln-verifier",
      "a4-compliance-guard",
      "a5-incident-responder",
      "a6-quality-steward",
      "a7-knowledge-weaver"
    ],
    "parallelism_allowed": false,
    "leader_promotion_allowed": false,
    "leader_generation": "manager creates independent Worker on Team creation"
