# AegIsLoop Adaptive — AgentTeams 环境变量样例
# 复制为 agentteams.env 并按需修改

# === Mock 工具网关 ===
MOCK_TOOL_BASE_URL=http://172.18.0.1:18090
MOCK_TOOL_PORT=18090

# === LLM 配置(由 hiclaw 安装器引导生成,这里只是样例) ===
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen3.7-plus

# === Worker 运行时 ===
WORKER_RUNTIME=qwenpow

# === Element Web ===
ELEMENT_WEB_PORT=18088

# === 团队标识 ===
TEAM_NAME=aegisloop-adaptive
TEAM_LEADER_NAME=aegisloop-leader
SCENARIO_DEFAULT=alert_brute_force

# === 可选:Observability(复赛) ===
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME=aegisloop-adaptive
# METRICS_BACKEND=prometheus
